<Project>

  <!--
    Build output is redirected to dist/<os>/<project-relative-path>/ so the repository tree stays
    free of per-project bin/obj folders and a single .gitignore entry covers every artifact.
    One folder per OS: Rider on Windows and dotnet in WSL share this tree, and a restore by one
    writes paths the other cannot read.
  -->
  <PropertyGroup>
    <RepositoryRoot>$([MSBuild]::EnsureTrailingSlash('$(MSBuildThisFileDirectory)'))</RepositoryRoot>
    <ProjectRelativePath>$([MSBuild]::MakeRelative('$(RepositoryRoot)', '$(MSBuildProjectDirectory)'))</ProjectRelativePath>
    <BuildOs Condition="'$(OS)' == 'Windows_NT'">windows</BuildOs>
    <BuildOs Condition="'$(OS)' != 'Windows_NT'">unix</BuildOs>
    <BaseOutputPath>$(RepositoryRoot)dist/$(BuildOs)/$(ProjectRelativePath)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RepositoryRoot)dist/$(BuildOs)/intermediates/$(ProjectRelativePath)/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- Needed only so IDE0005 (unused usings) is enforced at build; CS1591 (missing XML docs) stays off. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
