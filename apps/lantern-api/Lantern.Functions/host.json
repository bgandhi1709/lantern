{
  "version": "2.0",
  "telemetryMode": "OpenTelemetry",
  "logging": {
    "logLevel": {
      "default": "Information",
      "Azure.Core": "Warning",
      "Host.Triggers.ServiceBus": "Warning"
    }
  },
  "extensions": {
    "serviceBus": {
      "autoCompleteMessages": false,
      "maxConcurrentCalls": 4,
      "maxAutoLockRenewalDuration": "00:05:00"
    }
  }
}
