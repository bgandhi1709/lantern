<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the API for local Docker through WebApplicationFactory, so the stand-in for Firebase is
    applied after the API's own registrations and nothing dev-only lives in Lantern.Api or its production image.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Lantern.Api.Test.Integration.Host</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\apps\lantern-api\Lantern.Api\Lantern.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lantern.Api.Test.Integration" />
  </ItemGroup>

</Project>
