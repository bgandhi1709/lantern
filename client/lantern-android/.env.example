# Copy to .env, then pick ONE setup. Restart with `npx expo start --clear` after editing.

# UAT: the deployed API and real Firebase. Use this for the signed APK and a real phone.
EXPO_PUBLIC_API_BASE_URL=

# Local Docker, for debugging on the Android emulator (see README, "Debug against local Docker"):
# EXPO_PUBLIC_API_BASE_URL=https://10.0.2.2
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR=10.0.2.2:9099
