root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space

[*.cs]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.cs]
# Same choice as the approval API: a call with no x-api-version header gets v1, so curl and the
# first app builds work without it. Revisit when v2 exists.
dotnet_diagnostic.AV0016.severity = none

# The namespace mirrors the folder (CODING_STANDARDS.md, Architecture 7).
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0130.severity = error

# No unused usings. Enforced at build (needs GenerateDocumentationFile) and by the pre-commit hook.
dotnet_diagnostic.IDE0005.severity = error
